      <column caption='Teslimat Sapma Günü' datatype='integer' name='[Calculation_1390767911356555264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_delivered_customer_date], [order_estimated_delivery_date])' />
      </column>
      <column caption='Zamanında Teslimat KPI' datatype='string' name='[Calculation_1390767911357345793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_delay_days] &lt;= 0 THEN &apos;Zamanında/Erken&apos; &#13;&#10;ELSE &apos;Gecikti&apos; &#13;&#10;END' />
      </column>
      <column caption='Teslimat Durumu Renk' datatype='string' name='[Calculation_1390767911358025730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1390767911356555264] &lt; 0 THEN &apos;Gecikti&apos;&#13;&#10;ELSEIF [Calculation_1390767911356555264] = 0 THEN &apos;Tam Zamanında&apos;&#13;&#10;ELSE &apos;Erken Teslim Edildi&apos;&#13;&#10;END' />
      </column>
      <column caption='Kargo Yükü Oranı' datatype='real' name='[Calculation_1390767911358316547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([freight_value]) / SUM([price])' />
      </column>
      <column caption='Müşteri Deneyimi Sınıfı' datatype='string' name='[Calculation_889742450678497281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [review_score] &lt;= 2 THEN &apos;Negatif Deneyim&apos;&#13;&#10;ELSEIF [review_score] = 3 THEN &apos;Nötr Deneyim&apos;&#13;&#10;ELSEIF [review_score] &gt;= 4 THEN &apos;Pozitif Deneyim&apos;&#13;&#10;ELSE &apos;Bilinmiyor&apos;&#13;&#10;END' />
      </column>
      <column caption='Eyalet Bazlı Ortalama Gecikme (LOD)' datatype='real' name='[Calculation_889742450679037954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_state] : AVG([delivery_delay_days])}' />
      </column>
