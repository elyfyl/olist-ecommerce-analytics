              <calculation class='tableau' formula='IF [review_score] &lt;= 2 THEN &apos;Negatif Deneyim&apos;&#13;&#10;ELSEIF [review_score] = 3 THEN &apos;Nötr Deneyim&apos;&#13;&#10;ELSEIF [review_score] &gt;= 4 THEN &apos;Pozitif Deneyim&apos;&#13;&#10;ELSE &apos;Bilinmiyor&apos;&#13;&#10;END' />
